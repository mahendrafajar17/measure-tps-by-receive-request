  # ============================================================================
  # File Service Mock Endpoints
  # ============================================================================

  - id: "file_service_upload_success"
    name: "File Service Upload - Success"
    path: "/file-service/upload"
    config:
      status_code: 200
      content_type: "application/json"
      response_body: |
        {
          "result": "000",
          "fileUrl": "https://storage.mock-file-service.com/qris/FILE1733800000MOCK.png",
          "expiredAt": "2025-12-31T23:59:59+07:00"
        }
      timeout: 50
      headers:
        Content-Type: "application/json"
      enable_logging: true

  - id: "file_service_upload_error"
    name: "File Service Upload - Error"
    path: "/file-service/upload/error"
    config:
      status_code: 500
      content_type: "application/json"
      response_body: |
        {
          "success": false,
          "message": "File upload failed - Storage service unavailable",
          "error": "STORAGE_ERROR"
        }
      timeout: 50
      headers: {}
      enable_logging: true

  - id: "file_service_upload_unauthorized"
    name: "File Service Upload - Unauthorized"
    path: "/file-service/upload/unauthorized"
    config:
      status_code: 401
      content_type: "application/json"
      response_body: |
        {
          "success": false,
          "message": "Unauthorized - Invalid or missing token"
        }
      timeout: 50
      headers: {}
      enable_logging: true

  - id: "file_service_upload_timeout"
    name: "File Service Upload - Timeout"
    path: "/file-service/upload/timeout"
    config:
      status_code: 200
      content_type: "application/json"
      response_body: |
        {
          "success": true,
          "message": "Upload completed (delayed)",
          "data": null
        }
      timeout: 35000
      headers: {}
      enable_logging: true

  - id: "file_service_get_file"
    name: "File Service Get File Info"
    path: "/file-service/FILE1733800000MOCK"
    config:
      status_code: 200
      content_type: "application/json"
      response_body: |
        {
          "success": true,
          "data": {
            "fileId": "FILE1733800000MOCK",
            "fileUrl": "https://storage.mock-file-service.com/qris/FILE1733800000MOCK.png",
            "type": "image",
            "uploadedAt": "2025-12-09T10:15:00+07:00",
            "size": 45678,
            "mimeType": "image/png"
          }
        }
      timeout: 50
      headers: {}
      enable_logging: true

  # ============================================================================
  # Health Check & Utility Endpoints
  # ============================================================================

  - id: "health_check"
    name: "Health Check"
    path: "/ping"
    config:
      status_code: 200
      content_type: "application/json"
      response_body: |
        {
          "message": "Payment Gateway Mock Server is running!",
          "service": "mock-payment-gateway",
          "version": "1.0.0",
          "timestamp": "2025-12-09T10:00:00+07:00"
        }
      timeout: 10
      headers: {}
      enable_logging: false
