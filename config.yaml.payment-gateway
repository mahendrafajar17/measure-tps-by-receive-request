    path: "/2.0/api/merchant/checkout/error/invalid_merchant"
    config:
      status_code: 200
      content_type: "application/json"
      response_body: |
        {
          "responseCode": "4010001",
          "responseMessage": "Invalid Merchant ID",
          "data": null
        }
      timeout: 100
      headers: {}
      enable_logging: true

  - id: "top_checkout_error_internal"
    name: "TOP Checkout - Internal Server Error"
    path: "/2.0/api/merchant/checkout/error/internal"
    config:
      status_code: 200
      content_type: "application/json"
      response_body: |
        {
          "responseCode": "5000001",
