server:
  port: 8080
  host: "localhost"

logging:
  log_file: "webhook.log"
  log_level: "info"
  log_format: "text"

# Redis configuration for caching and session management
redis:
  host: "localhost"
  port: 6379
  password: ""
  database: 0
  max_retries: 3
  pool_size: 10
  connect_timeout: 5s

# Telegram alert configuration for monitoring and notifications
telegram:
  url: "https://api.telegram.org/bot5801394322:AAEaWtt-jGFb81sT7KqrUOw1Pg9m9dtkWas/sendMessage"
  chat_id: "-4886766411"
  product: "TPS Measurement Tool"
  application: "webhook-server"
  retry:
    max_retry: 3
    interval: 5s
  alerts:
    high_tps_threshold: 1000
    error_rate_threshold: 5.0
    enable_performance_alerts: true
    enable_error_alerts: true

# Database configuration (if needed for persistence)
database:
  enabled: false
  host: "localhost"
  port: 5432
  username: "webhook_user"
  password: "webhook_pass"
  database: "webhook_metrics"
  max_pool_size: 10
  connect_timeout: 5

default_webhooks:
