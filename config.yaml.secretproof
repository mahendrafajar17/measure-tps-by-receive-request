server:
  port: 8080
  host: "localhost"

logging:
  log_file: "webhook.log"
  log_level: "info"
  log_format: "text"

# Redis configuration for caching and session management
redis:
  host: "localhost"
  port: 6379
  password: ""
  database: 0
  max_retries: 3
  pool_size: 10
  connect_timeout: 5s

# Telegram alert configuration for monitoring and notifications
telegram:
  url: "https://api.telegram.org/bot5801394322:AAEaWtt-jGFb81sT7KqrUOw1Pg9m9dtkWas/sendMessage"
  chat_id: "-4886766411"
  product: "TPS Measurement Tool"
  application: "webhook-server"
  retry:
    max_retry: 3
    interval: 5s
  alerts:
    high_tps_threshold: 1000
    error_rate_threshold: 5.0
    enable_performance_alerts: true
    enable_error_alerts: true

# Database configuration (if needed for persistence)
database:
  enabled: false
  host: "localhost"
  port: 5432
  username: "webhook_user"
  password: "webhook_pass"
  database: "webhook_metrics"
  max_pool_size: 10
  connect_timeout: 5

default_webhooks:
  - id: "fast"
    name: "Fast Webhook"
    path: "/webhook/fast"
    config:
      status_code: 200
      content_type: "application/json"
      response_body: '{"message": "Fast response", "delay": "0ms"}'
      timeout: 0
      headers: {}
      enable_logging: false

  - id: "slow"
    name: "Slow Webhook"
    path: "/webhook/slow"
    config:
      status_code: 200
      content_type: "application/json"
      response_body: '{"message": "Slow response", "delay": "2000ms"}'
      timeout: 2000
      headers: {}
      enable_logging: true

  - id: "pct_auth"
    name: "PCT Auth Login"
    path: "/pct/auth/login"
    config:
      status_code: 200
      content_type: "application/json"
      response_body: '{"code": 0, "token": "mock_jwt_token_12345", "expire": "2024-01-15T12:00:00Z", "message": "success"}'
      timeout: 100
      headers: {}
      enable_logging: true

  - id: "pct_rcs_report"
    name: "PCT RCS Report API"
    path: "/pct/api/request/rcs_report"
    config:
      status_code: 200
      content_type: "application/json"
      response_body: '{"code": 0, "message": "Request accepted", "status": "success", "data": {}}'
      timeout: 50
      headers: {}
      enable_logging: true
  - id: "forward1"
    name: "Forward1"
    path: "/forward1"
    config:
      status_code: 200
      content_type: "application/json"
      response_body: '{"message": "Fast response", "delay": "0ms"}'
      timeout: 0
      headers: {}
      enable_logging: false
  - id: "forward2"
    name: "Forward2"
    path: "/forward2"
    config:
      status_code: 200
      content_type: "application/json"
      response_body: '{"message": "Fast response", "delay": "0ms"}'
      timeout: 0
      headers: {}
      enable_logging: false

  # Meta API Dummy Endpoints
  - id: "meta_me"
    name: "Meta Graph API - Me"
    path: "/me"
    config:
      status_code: 200
      content_type: "application/json"
      response_body: '{"id": "123456789", "name": "Test User", "email": "test@example.com"}'
      timeout: 100
      headers: {}
      enable_logging: true

  - id: "meta_pages"
    name: "Meta Graph API - Pages"
    path: "/me/pages"
    config:
      status_code: 200
      content_type: "application/json"
      response_body: '{"data": [{"id": "page123", "name": "Test Page", "access_token": "page_token_123"}]}'
      timeout: 150
      headers: {}
      enable_logging: true

  - id: "meta_webhooks"
    name: "Meta Graph API - Webhooks"
    path: "/:page_id/subscriptions"
    config:
      status_code: 200
      content_type: "application/json"
      response_body: '{"success": true, "id": "webhook_123"}'
      timeout: 200
      headers: {}
      enable_logging: true

  - id: "meta_messages_default"
    name: "Meta Graph API - Default Messages Endpoint"
    path: "/v17.0/:page_id/messages"
    config:
      status_code: 200
      content_type: "application/json"
      response_body: '{"messaging_product": "whatsapp", "contacts": [{"input": "+628123456789", "wa_id": "628123456789"}], "messages": [{"id": "wamid.dummy_message_id_default"}]}'
      timeout: 100
      headers: {}
      enable_logging: true

  - id: "meta_messages_marketing"
    name: "Meta Graph API - Marketing Messages Endpoint"
    path: "/v17.0/:page_id/marketing_messages"
    config:
      status_code: 200
      content_type: "application/json"
      response_body: '{"messaging_product": "whatsapp", "contacts": [{"input": "+628123456789", "wa_id": "628123456789"}], "messages": [{"id": "wamid.dummy_message_id_marketing"}]}'
      timeout: 100
      headers: {}
      enable_logging: true

  # Error Response Endpoints for Negative Testing
  - id: "meta_error_token_expired"
    name: "Meta Graph API - Token Expired Error"
    path: "/v17.0/error_token/messages"
    config:
      status_code: 401
      content_type: "application/json"
      response_body: '{"error": {"message": "Invalid OAuth access token.", "type": "OAuthException", "code": 190, "error_subcode": 463, "fbtrace_id": "dummy_trace_id"}}'
      timeout: 100
      headers: {}
      enable_logging: true

  - id: "meta_error_token_expired_marketing"
    name: "Meta Graph API - Token Expired Error (Marketing)"
    path: "/v17.0/error_token/marketing_messages"
    config:
      status_code: 401
      content_type: "application/json"
      response_body: '{"error": {"message": "Invalid OAuth access token.", "type": "OAuthException", "code": 190, "error_subcode": 463, "fbtrace_id": "dummy_trace_id"}}'
      timeout: 100
      headers: {}
      enable_logging: true

  - id: "meta_error_invalid_phone"
    name: "Meta Graph API - Invalid Phone Number Error"
    path: "/v17.0/error_phone/messages"
    config:
      status_code: 400
      content_type: "application/json"
      response_body: '{"error": {"message": "Invalid phone number format", "type": "InvalidParameter", "code": 100, "error_data": {"messaging_product": "whatsapp", "details": "Phone number format is invalid"}}}'
      timeout: 100
      headers: {}
      enable_logging: true

  - id: "meta_error_invalid_phone_marketing"
    name: "Meta Graph API - Invalid Phone Number Error (Marketing)"
    path: "/v17.0/error_phone/marketing_messages"
    config:
      status_code: 400
      content_type: "application/json"
      response_body: '{"error": {"message": "Invalid phone number format", "type": "InvalidParameter", "code": 100, "error_data": {"messaging_product": "whatsapp", "details": "Phone number format is invalid"}}}'
      timeout: 100
      headers: {}
      enable_logging: true

  - id: "meta_error_rate_limit"
    name: "Meta Graph API - Rate Limit Error"
    path: "/v17.0/error_rate/messages"
    config:
      status_code: 429
      content_type: "application/json"
      response_body: '{"error": {"message": "Too many calls", "type": "OAuthException", "code": 4, "error_subcode": 2018109, "fbtrace_id": "dummy_rate_limit_trace"}}'
      timeout: 100
      headers: {}
      enable_logging: true

  - id: "meta_error_rate_limit_marketing"
    name: "Meta Graph API - Rate Limit Error (Marketing)"
    path: "/v17.0/error_rate/marketing_messages"
    config:
      status_code: 429
      content_type: "application/json"
      response_body: '{"error": {"message": "Too many calls", "type": "OAuthException", "code": 4, "error_subcode": 2018109, "fbtrace_id": "dummy_rate_limit_trace"}}'
      timeout: 100
      headers: {}
      enable_logging: true

  - id: "meta_error_template_invalid"
    name: "Meta Graph API - Invalid Template Error"
    path: "/v17.0/error_template/messages"
    config:
      status_code: 400
      content_type: "application/json"
      response_body: '{"error": {"message": "Template parameter count mismatch", "type": "InvalidParameter", "code": 132000, "error_data": {"messaging_product": "whatsapp", "details": "Template parameter validation failed"}}}'
      timeout: 100
      headers: {}
      enable_logging: true

  - id: "meta_error_template_invalid_marketing"
    name: "Meta Graph API - Invalid Template Error (Marketing)"
    path: "/v17.0/error_template/marketing_messages"
    config:
      status_code: 400
      content_type: "application/json"
      response_body: '{"error": {"message": "Template parameter count mismatch", "type": "InvalidParameter", "code": 132000, "error_data": {"messaging_product": "whatsapp", "details": "Template parameter validation failed"}}}'
      timeout: 100
      headers: {}
      enable_logging: true

  - id: "meta_error_missing_fields"
    name: "Meta Graph API - Missing Required Fields Error"
    path: "/v17.0/error_missing/messages"
    config:
      status_code: 400
      content_type: "application/json"
      response_body: '{"error": {"message": "Missing required parameter: language", "type": "InvalidParameter", "code": 100, "error_data": {"messaging_product": "whatsapp", "details": "language is required"}}}'
      timeout: 100
      headers: {}
      enable_logging: true

  - id: "meta_error_missing_fields_marketing"
    name: "Meta Graph API - Missing Required Fields Error (Marketing)"
    path: "/v17.0/error_missing/marketing_messages"
    config:
      status_code: 400
      content_type: "application/json"
      response_body: '{"error": {"message": "Missing required parameter: language", "type": "InvalidParameter", "code": 100, "error_data": {"messaging_product": "whatsapp", "details": "language is required"}}}'
      timeout: 100
      headers: {}
      enable_logging: true

  - id: "meta_error_network_timeout"
    name: "Meta Graph API - Network Timeout Simulation"
    path: "/v17.0/error_network/messages"
    config:
      status_code: 500
      content_type: "application/json"
      response_body: '{"error": {"message": "Internal Server Error", "type": "ServerError", "code": 500, "fbtrace_id": "dummy_server_error_trace"}}'
      timeout: 5000
      headers: {}
      enable_logging: true

  - id: "meta_error_network_timeout_marketing"
    name: "Meta Graph API - Network Timeout Simulation (Marketing)"
    path: "/v17.0/error_network/marketing_messages"
    config:
      status_code: 500
      content_type: "application/json"
      response_body: '{"error": {"message": "Internal Server Error", "type": "ServerError", "code": 500, "fbtrace_id": "dummy_server_error_trace"}}'
      timeout: 5000
      headers: {}
      enable_logging: true